# Copy to .env for local development. Never commit a real .env.
ENVIRONMENT=local
DEBUG=true

SECRET_KEY=dev-only-secret-change-me
DATABASE_URL=postgresql+asyncpg://corredor:corredor@localhost:5432/corredor
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000"]

# Intelligence layer (optional locally; baselines run without it)
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ENABLE_AI_TRIAGE=false

# WhatsApp Cloud API (Módulo 3, phase 2)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Public web app
NEXT_PUBLIC_API_URL=http://localhost:8000
